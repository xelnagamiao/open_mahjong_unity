# 仓库根目录白名单：四个主项目、共享素材、Git 规则、README 与许可证。
# 新增根目录默认不提交；本机工作约定与工具保留在本机。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/open_mahjong_chatServer/
!/open_mahjong_server/
!/open_mahjong_unity/
!/open_mahjong_web/
!/other/

# Unity 仅提交源码、资源、项目设置、依赖锁与维护文档。
/open_mahjong_unity/*
!/open_mahjong_unity/Assets/
!/open_mahjong_unity/Packages/
!/open_mahjong_unity/ProjectSettings/
!/open_mahjong_unity/Docs/
!/open_mahjong_unity/README.md
/open_mahjong_unity/Assets/Resources/PerformanceTestRunInfo.json*
/open_mahjong_unity/Assets/Resources/PerformanceTestRunSettings.json*

# Python 项目的源码入口；虚拟环境和本机部署文件不进入仓库。
/open_mahjong_server/*
!/open_mahjong_server/requirements.txt
!/open_mahjong_server/main.py
!/open_mahjong_server/start_server.bat
!/open_mahjong_server/README.md
!/open_mahjong_server/server/
!/open_mahjong_server/tests/
!/open_mahjong_server/docs/
/open_mahjong_server/server/error_log/
/open_mahjong_server/server/local_config.py
/open_mahjong_server/logs/

# 依赖、缓存、编辑器配置与临时输出（不忽略实际源码或 Unity 插件）。
node_modules/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vite/
.vscode/
.cursor/
.idea/
.om_workspace/
.deploy_staging/
AGENTS.md
WORKSPACE_RULES.md
tmp/
Temp/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.orig
*.lnk
*.blend[0-9]*
*~

# 本机凭据：仓库只提供占位示例，不提交运行时生成的密钥。
.env
.env.*
!/open_mahjong_web/.env.example
!/open_mahjong_server/.env.example
!/open_mahjong_chatServer/.env.example
*.pem
*.key
secret_key.txt
/open_mahjong_chatServer/open_mahjong_chatServer
/open_mahjong_chatServer/open_mahjong_chatServer.exe
/open_mahjong_server/server/chat_server/open_mahjong_chatServer
/open_mahjong_server/server/chat_server/open_mahjong_chatServer.exe

# Web 构建输出及本机放置的游戏包；public 下仅保留放置说明。
/open_mahjong_web/client/dist/
/open_mahjong_web/client/coverage/
/open_mahjong_web/client/public/unity-game/*
!/open_mahjong_web/client/public/unity-game/*.md
/open_mahjong_web/client/public/android-game/*
!/open_mahjong_web/client/public/android-game/*.md
/open_mahjong_web/client/public/ios-game/*
!/open_mahjong_web/client/public/ios-game/*.md
/open_mahjong_web/client/public/activity-assets/

# 用户上传与运行数据；保留必要的空目录占位。
/open_mahjong_web/data/activities/**
!/open_mahjong_web/data/activities/.gitkeep
/open_mahjong_web/data/activity-assets/**
!/open_mahjong_web/data/activity-assets/.gitkeep
/open_mahjong_web/data/user-content/**
!/open_mahjong_web/data/user-content/.gitkeep
/open_mahjong_web/data/fun-data/**
!/open_mahjong_web/data/fun-data/.gitkeep
/open_mahjong_web/data/record-convert-shares/

# other 只提交共享素材、配表、规则资料及其来源/许可证/说明。
# 生成器、一次性工具、构建和验收过程文件放 .om_workspace/。
/other/UnityBatchBuild/
/other/**/[Tt]ools/
/other/**/_tools/
/other/**/[Bb]uild/
/other/**/[Bb]uilds/
/other/**/validation/
/other/**/*.py
/other/**/*.ps1
/other/**/*.bat
/other/**/*.cmd
/other/**/*.sh
/other/**/*.exe
/other/tiles/face-build.json
