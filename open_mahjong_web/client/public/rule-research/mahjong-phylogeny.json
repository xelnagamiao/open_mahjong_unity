    {
      "id": "zj-classical",
      "url": "http://www.zj-mahjong.info/book_hk/2.0%20Early%20Classical.html",
      "title": "中庸麻雀史观 · 第二章 中国古典麻雀（早期）",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "strong-secondary",
      "reliability": "high",
      "excerpt": "关兆豪采用榛原茂树1952年文章为早期古典参考。榛原据五本中国1910–20年代麻雀古籍编成「想定宁波规则」，并假设为最早规则；其资料已是10–20年代刊物，与更早章法会有细节出入。",
      "local_kind": "file",
      "local_path": "mahjong-phylogeny/files/zj-classical.html",
      "local_status": "ok",
      "rules": [
        "classical"
      ]
    },
    {
      "id": "zj-oldstyle",
      "url": "http://www.zj-mahjong.info/book_hk/4.0%20Old%20Style.html",
      "title": "中庸麻雀史观 · 第七章 香港旧章麻雀",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "strong-secondary",
      "reliability": "high",
      "excerpt": "从古典到香港旧章只需两点：废除副点（光算番数），授受改为出铳么二制。旧章又称香港牌、广东牌或清章麻雀。",
      "local_kind": "file",
      "local_path": "mahjong-phylogeny/files/zj-oldstyle.html",
      "local_status": "ok",
      "rules": [
        "qingzhang",
        "hongkong"
      ]
    },
    {
      "id": "zj-newstyle",
      "url": "http://www.zj-mahjong.info/book_hk/5.0%20New%20Style.html",
      "title": "中庸麻雀史观 · 第九章 新章麻雀",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "strong-secondary",
      "reliability": "medium",
      "excerpt": "新章把古典加副要素（边、嵌、单钓）升值为一番，并加将眼等易和种，关兆豪称为滥番。新章部分和种传入日本及台湾，香港后来「集体失忆」。",
      "local_kind": "file",
      "local_path": "mahjong-phylogeny/files/zj-newstyle.html",
      "local_status": "ok",
      "rules": [
        "guangdong",
        "hongkong"
      ]
    },
    {
      "id": "zj-jp-classical",
      "url": "http://www.zj-mahjong.info/book_hk/6.0%20Japanese%20Classical.html",
      "title": "中庸麻雀史观 · 日本古典麻雀",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "strong-secondary",
      "reliability": "high",
      "excerpt": "后期中国古典传入日本后称日本古典麻雀。日本章法是主要章法中唯一采用真正全铳制的。现日本已很少人懂，西方因 Kanai & Farrell、Whitney 英文书仍有人玩。",
      "local_kind": "file",
      "local_path": "mahjong-phylogeny/files/zj-jp-classical.html",
      "local_status": "ok",
      "rules": [
        "japanese-classical"
      ]
    },
    {
      "id": "zj-jp-modern",
      "url": "http://www.zj-mahjong.info/book_hk/7.0%20Japanese%20Modern.html",
      "title": "中庸麻雀史观 · 第十一章 日本现代麻雀",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "strong-secondary",
      "reliability": "high",
      "excerpt": "日本现代麻雀即立直麻雀。门前听牌可宣言立直，以后不能转张，和出加一番；另加ドラ（宝牌）。里ドラ、一发等为更后添加。",
      "local_kind": "file",
      "local_path": "mahjong-phylogeny/files/zj-jp-modern.html",
      "local_status": "ok",
      "rules": [
        "riichi"
      ]
    },
    {
      "id": "wiki-zh-origin",
      "url": "https://zh.wikipedia.org/wiki/%E9%BA%BB%E5%B0%86",
      "title": "麻将（中文维基百科）起源与名称",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "community",
      "reliability": "medium",
      "excerpt": "发源地有宁波与闽粤二说，尚未定论。沈一帆（1914）「始于宁波，不过三十余年」。徐珂一处宁波始，一处粤寇流入宁波。杜亚泉《博史》主张先闽粤，光绪初由宁波江厦延及津沪。麻将二字一般认为是北部吴语「麻雀」儿化。",
      "local_kind": "snapshot",
      "local_path": "mahjong-phylogeny/snapshots/wiki-zh-origin.html",
      "local_status": "ok",
      "rules": [
        "proto-mahjong"
      ]
    },
    {
      "id": "wiki-zh-play",
      "url": "https://zh.wikipedia.org/wiki/%E9%BA%BB%E5%B0%86",
      "title": "麻将（中文维基百科）前身与玩法",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "community",
      "reliability": "medium",
      "excerpt": "牌张公认来自马吊，玩法来自默和/碰和/十湖，马吊本身是斗大而非凑牌。最早规则书层可追溯到1910年代榛原收集本；计分番副，未和者也计分。",
      "local_kind": "snapshot",
      "local_path": "mahjong-phylogeny/snapshots/wiki-zh-origin.html",
      "local_status": "ok",
      "rules": [
        "proto-mahjong",
        "classical"
      ]
    },
    {
      "id": "wiki-zh-legend",
      "url": "https://zh.wikipedia.org/wiki/%E9%BA%BB%E5%B0%86",
      "title": "麻将（中文维基百科）传说",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "community",
      "reliability": "medium",
      "excerpt": "陈鱼门说除其人真实外暂无实据；清末民初作家未提陈与麻将有关。Powell 1923 英文「施–陈–张」传说。天一阁宣传之夏福礼日记，Sloper 等向千叶博物馆索副本无馆藏。",
      "local_kind": "snapshot",
      "local_path": "mahjong-phylogeny/snapshots/wiki-zh-origin.html",
      "local_status": "ok",
      "rules": [
        "proto-mahjong"
      ]
    },
    {
      "id": "cnnb-2018",
      "url": "http://news.cnnb.com.cn/system/2018/12/15/030011174.shtml",
      "title": "专家考证：麻将在宁波定型并走向全国 并非郑和发明",
      "type": "history",
      "lang": "zh",
      "accessed": "2026-08-14",
      "source_level": "strong-secondary",
      "reliability": "high",
      "excerpt": "杜亚泉言马将牌先流行于闽粤濒海及海舶，光绪初由宁波江厦演及津沪，五口通商后在宁波改制骨牌再由津沪波及全国。作者认为闽粤说无一手支撑，定型与外传源头应是宁波。",
      "local_kind": "snapshot",
      "local_path": "mahjong-phylogeny/snapshots/cnnb-2018.html",
