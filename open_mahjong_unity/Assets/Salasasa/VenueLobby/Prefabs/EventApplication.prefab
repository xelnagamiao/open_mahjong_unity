  m_text: "\u2022 \u8D5B\u4E8B\u7684\u7EC4\u7EC7\u3001\u5956\u91D1\u7B49\u5404\u9879\u6210\u672C\u5F00\u652F\u4E0D\u5F97\u4F4E\u4E8E\u62A5\u540D\u8D39\u7684
    80%\uFF0C\u5982\u8D5B\u4E8B\u5956\u52B1\u4E2D\u63D0\u4F9B\u66F4\u4E0A\u7EA7\u6BD4\u8D5B\u540D\u989D\u6216\u7279\u6B8A\u5956\u52B1\u7684\uFF0C\u53EF\u4EE5\u8FDB\u884C\u72EC\u7ACB\u6838\u7B97\u3002\n\u2022
