  "legends_not_edges": [
    {
      "id": "chen-yumen",
      "label": "陈鱼门 1864 发明",
      "desc": "民间常说宁波人陈鱼门在马吊牌基础上定出了万索筒和番例，1864 年前后成型。这个说法流传最广，但至今没找到能核验的一手材料，只能当传闻。"
    },
    {
      "id": "zheng-he",
      "label": "郑和发明",
      "desc": "另一种说法是郑和下西洋时，为了让水手在船上解闷而发明了麻将，牌张对应罗盘、水手更次等航海元素。同样缺文献佐证，多是后人附会。"
    },
    {
      "id": "confucius",
      "label": "孔子／一行发明",
      "desc": "还有把发明人说成孔子，或唐代僧人一行的版本，理由多是把「万、索、筒」三种牌附会成经典或历法概念。属于民间穿凿，不是历史考证。"
    },
    {
      "id": "taicang-grain",
      "label": "太仓护粮牌",
      "desc": "太仓一带流传护粮牌的说法：粮仓工人为了防雀鸟偷粮记数量、防偷粮的差役换班交接，用牌记账，渐渐演变成麻将。这是地方口述，未见文献支持。"
    }
  ],
  "glossary": [
    {
      "id": "quzi",
      "label": "去字",
      "desc": "打牌不用东南西北、中发白这些字牌，只留万条筒数字牌，川渝湘一带常见的改法。"
    },
    {
      "id": "jinchi",
      "label": "禁吃",
      "desc": "不能吃别家打出的牌凑顺子，只能靠自己摸牌、碰、杠，川渝湘、常德一带的常见规矩。"
    },
    {
      "id": "dingque",
      "label": "定缺",
      "desc": "开局前先选一门缺号（万、条或筒），这一门的牌只能打出不能留，成都血战到底常用这个规矩。"
    },
    {
      "id": "huansanzhang",
      "label": "换三张",
      "desc": "开局三家先各挑三张同一门的牌互相交换，再决定缺哪门或直接开打，不少川麻桌上把它当开局选项。"
    },
    {
      "id": "lizhi",
      "label": "立直",
      "desc": "摸到听牌时扣 1000 点分报牌，之后打出的牌不能再换，是日本麻将（天凤、雀魂等平台）的核心规矩之一。"
    },
    {
      "id": "taishu",
      "label": "台数",
      "desc": "台湾麻将按番种、门风、连庄等叠算「台」，台数越高赢得越多；2001 年明星三缺一把这套口传台数写成了电脑规则。"
    },
    {
      "id": "laizi",
      "label": "癞子",
      "desc": "可以当任意牌用的万能牌。常德麻将用红中当癞子，因此也被叫做「红中麻将」。"
    },
    {
      "id": "baoting",
      "label": "报听",
      "desc": "手牌听牌（差一张就能和）时要主动喊出来，别家打出这张就必须让和，常见于常德、武汉一带的癞子麻将。"
    },
    {
      "id": "huapai",
      "label": "花牌／算花",
      "desc": "额外的春夏秋冬、梅兰竹菊等花牌，摸到直接补牌加分。苏州、南京一带的算花麻将靠花牌数量定输赢大小。"
    },
    {
      "id": "lisi",
      "label": "立四",
      "desc": "太原一带的都市玩法：指定的四张牌摸到要立起来展示，算加分项目。"
    },
    {
      "id": "258jiang",
      "label": "258 将",
      "desc": "将牌（对子）限定用 2、5、8 点数才算番，是长沙、湖南一带麻将常见的算番方式。"
    }
  ],
