  pages:
  - section: "01 / \u8BA4\u8BC6\u4E00\u526F\u724C"
    title: "\u4E00\u526F\u56FD\u6807\u9EBB\u5C06\uFF0C\u4E00\u5171 144 \u5F20"
    summary: "\u628A\u724C\u5148\u5206\u6210\u4E09\u7C7B\uFF1A\u6570\u724C\u3001\u5B57\u724C\u3001\u82B1\u724C\u3002\n\u4E0D\u7528\u6025\u7740\u8BB0\u756A\u79CD\uFF0C\u4ECA\u5929\u5148\u8BA4\u6E05\u724C\u9762\u3002"
    narration: "\u6B22\u8FCE\u6765\u5230\u9EBB\u96C0\u6559\u5BA4\uFF01\u6211\u662F\u742A\u9732\u8BFA\u3002\u5148\u4E00\u8D77\u8BA4\u8BC6\u9EBB\u5C06\u724C\u5427\u2014\u2014\u6570\u724C
      108 \u5F20\uFF0C\u5B57\u724C 28 \u5F20\uFF0C\u518D\u52A0 8 \u5F20\u82B1\u724C\u3002"
    takeaway: "\u8BB0\u4F4F\u4E09\u4E2A\u540D\u5B57\uFF1A\u6570\u724C \xB7 \u5B57\u724C
      \xB7 \u82B1\u724C"
    groups:
    - heading: "\u6570\u724C / 108 \u5F20"
      tileIds: 0b0000001900000027000000
    - heading: "\u5B57\u724C / 28 \u5F20"
      tileIds: 290000002d0000002e000000
    - heading: "\u82B1\u724C / 8 \u5F20"
      tileIds: 330000003700000038000000
  - section: "02 / \u6570\u724C \xB7 \u4E07"
    title: "\u4E07\u724C\uFF1A\u4ECE\u4E00\u4E07\uFF0C\u5230\u4E5D\u4E07"
    summary: "\u770B\u724C\u9762\u4E0A\u7684\u6C49\u5B57\u6570\u5B57\u548C\u201C\u842C\u201D\u3002\n\u4E00\u5230\u4E5D\u5404\u662F\u4E00\u79CD\u724C\uFF0C\u6BCF\u79CD\u90FD\u6709
      4 \u5F20\uFF0C\u5171 36 \u5F20\u3002"
    narration: "\u8FD9\u662F\u4E07\u724C\uFF01\u6570\u5B57\u544A\u8BC9\u4F60\u5B83\u662F\u51E0\u4E07\u3002\u6BD4\u5982\u4E8C\u4E07\u548C\u4E09\u4E07\u662F\u4E0D\u540C\u7684\u724C\uFF0C\u4E24\u5F20\u4E94\u4E07\u624D\u662F\u540C\u4E00\u79CD\u724C\u3002"
    takeaway: "9 \u79CD\u4E07\u724C\uFF0C\u6BCF\u79CD 4 \u5F20\uFF0C\u5171 36 \u5F20\u3002"
    groups:
    - heading: "\u4E07\u5B50 / 1\u20149"
      tileIds: 0b0000000c0000000d0000000e0000000f00000010000000110000001200000013000000
  - section: "03 / \u6570\u724C \xB7 \u7B52"
    title: "\u7B52\u724C\uFF1A\u6570\u4E00\u6570\u5706\u5708"
    summary: "\u7B52\u724C\u4E5F\u5E38\u53EB\u201C\u997C\u724C\u201D\u3002\n\u4ECE\u4E00\u7B52\u5230\u4E5D\u7B52\uFF0C\u6BCF\u79CD
      4 \u5F20\uFF0C\u5171 36 \u5F20\u3002"
    narration: "\u8FD9\u4E9B\u5706\u5708\u5C31\u662F\u7B52\u724C\u7684\u6807\u8BB0\u3002\u4E00\u7B52\u901A\u5E38\u753B\u6210\u4E00\u4E2A\u5927\u5706\uFF0C\u5176\u4ED6\u7B52\u724C\u53EF\u4EE5\u6570\u5706\u5708\u3002\u4E94\u7B52\u548C\u4E94\u4E07\u867D\u7136\u90FD\u662F\u4E94\uFF0C\u82B1\u8272\u5374\u4E0D\u540C\u54E6\u3002"
    takeaway: "\u6570\u5B57\u76F8\u540C\u3001\u82B1\u8272\u4E0D\u540C\uFF0C\u4ECD\u7136\u662F\u4E0D\u540C\u7684\u724C\u3002"
    groups:
    - heading: "\u7B52\u5B50 / 1\u20149"
      tileIds: 15000000160000001700000018000000190000001a0000001b0000001c0000001d000000
  - section: "04 / \u6570\u724C \xB7 \u6761"
    title: "\u6761\u724C\uFF1A\u7AF9\u8282\u91CC\u85CF\u7740\u4E00\u53EA\u9E1F"
    summary: "\u6761\u724C\u4E5F\u53EB\u201C\u7D22\u724C\u201D\uFF0C\u540C\u6837\u662F\u4E00\u5230\u4E5D\u3002\n\u4E00\u6761\u901A\u5E38\u753B\u6210\u9E1F\uFF0C\u4E0D\u8981\u56E0\u4E3A\u6CA1\u6709\u7AF9\u8282\u5C31\u8BA4\u9519\u5B83\u3002"
    narration: "\u627E\u5230\u90A3\u53EA\u5C0F\u9E1F\u4E86\u5417\uFF1F\u5B83\u662F\u4E00\u6761\uFF01\u4E8C\u6761\u5230\u4E5D\u6761\u7528\u7AF9\u8282\u56FE\u6848\u8868\u793A\u3002\u4E07\u3001\u7B52\u3001\u6761\u4E09\u79CD\u82B1\u8272\uFF0C\u6BCF\u4E00\u79CD\u90FD\u6709
      36 \u5F20\u3002"
    takeaway: "3 \u79CD\u82B1\u8272\uFF0C\u6BCF\u79CD 36 \u5F20\uFF0C\u5171 108 \u5F20\u6570\u724C\u3002"
    groups:
    - heading: "\u6761\u5B50 / 1\u20149"
      tileIds: 1f0000002000000021000000220000002300000024000000250000002600000027000000
  - section: "05 / \u5B57\u724C"
    title: "\u56DB\u79CD\u98CE\u724C\uFF0C\u4E09\u79CD\u7BAD\u724C"
    summary: "\u98CE\u724C\uFF1A\u4E1C\u3001\u5357\u3001\u897F\u3001\u5317\u3002\u7BAD\u724C\uFF1A\u4E2D\u3001\u53D1\u3001\u767D\u3002\n7
      \u79CD\u5B57\u724C\uFF0C\u6BCF\u79CD 4 \u5F20\uFF0C\u5171 28 \u5F20\u3002"
    narration: "\u5E26\u6587\u5B57\u7684\u8FD9\u4E9B\u724C\u53EB\u5B57\u724C\u3002\u767D\u677F\u6709\u65F6\u662F\u7A7A\u767D\uFF0C\u6709\u65F6\u753B\u7740\u8FB9\u6846\u3002\u8981\u8BB0\u4F4F\uFF1A\u4E1C\u3001\u5357\u3001\u897F\u4E0D\u80FD\u50CF\u4E00\u4E8C\u4E09\u90A3\u6837\u7EC4\u6210\u987A\u5B50\u3002"
    takeaway: "\u5B57\u724C\u6CA1\u6709\u6570\u5B57\u987A\u5E8F\uFF0C\u4E0D\u80FD\u7EC4\u6210\u987A\u5B50\u3002"
    groups:
    - heading: "\u98CE\u724C\u4E0E\u7BAD\u724C"
      tileIds: 290000002a0000002b0000002c0000002d0000002f0000002e000000
  - section: "06 / \u82B1\u724C"
    title: "\u516B\u5F20\u82B1\u724C\uFF0C\u6BCF\u5F20\u53EA\u6709\u4E00\u5F20"
    summary: "\u6625\u3001\u590F\u3001\u79CB\u3001\u51AC\uFF1B\u6885\u3001\u5170\u3001\u7AF9\u3001\u83CA\u3002\n\u82B1\u724C\u4E0E\u5176\u4ED6\u724C\u4E0D\u540C\uFF1A\u6BCF\u4E00\u79CD\u53EA\u6709
      1 \u5F20\u3002"
    narration: "\u82B1\u724C\u5F88\u597D\u8BA4\uFF01\u6478\u5230\u540E\u8981\u4EAE\u51FA\uFF0C\u518D\u4ECE\u724C\u5899\u672B\u7AEF\u8865\u724C\uFF1B\u5982\u679C\u53C8\u8865\u5230\u82B1\uFF0C\u5C31\u7EE7\u7EED\u8865\u3002\u82B1\u724C\u5355\u72EC\u6446\u653E\uFF0C\u4E0D\u62FF\u6765\u7EC4\u6210\u666E\u901A\u7684\u987A\u5B50\u3001\u523B\u5B50\u6216\u5BF9\u5B50\u3002"
    takeaway: "\u6478\u5230\u82B1\u724C\uFF1A\u5148\u4EAE\u51FA\uFF0C\u518D\u8865\u724C\uFF1B\u8865\u5230\u82B1\u724C\u7EE7\u7EED\u8865\u3002"
    groups:
    - heading: "\u56DB\u5B63\u4E0E\u56DB\u541B\u5B50"
      tileIds: 330000003400000035000000360000003700000038000000390000003a000000
  - section: "07 / \u5F20\u6570"
    title: "\u540C\u4E00\u79CD\u5E38\u89C4\u724C\uFF0C\u90FD\u6709\u56DB\u5F20"
    summary: "\u6570\u724C\u548C\u5B57\u724C\uFF0C\u6BCF\u4E00\u79CD\u90FD\u91CD\u590D
      4 \u6B21\u3002\n\u6570\u724C 108 \u5F20 + \u5B57\u724C 28 \u5F20 = 136 \u5F20\uFF1B\u518D\u52A0
      8 \u5F20\u82B1\u724C\uFF0C\u5171 144 \u5F20\u3002"
    narration: "\u770B\uFF0C\u8FD9\u56DB\u5F20\u90FD\u662F\u4E94\u4E07\uFF0C\u5B83\u4EEC\u7684\u8EAB\u4EFD\u5B8C\u5168\u4E00\u6837\u3002\u6570\u724C\u4E0E\u5B57\u724C\u9075\u5B88\u201C\u6BCF\u79CD\u56DB\u5F20\u201D\uFF0C\u82B1\u724C\u5219\u662F\u201C\u6BCF\u79CD\u4E00\u5F20\u201D\u2014\u2014\u522B\u628A\u5B83\u4EEC\u8BB0\u53CD\u5566\u3002"
    takeaway: "\u8BA4\u724C\u5C0F\u53E3\u8BC0\uFF1A\u6570\u724C\u5B57\u724C\u5404\u56DB\u5F20\uFF0C\u516B\u79CD\u82B1\u724C\u5404\u4E00\u5F20\u3002"
    groups:
    - heading: "\u540C\u4E00\u79CD\u724C / \u56DB\u5F20\u4E94\u4E07"
      tileIds: 0f0000000f0000000f0000000f000000
  - section: "08 / \u57FA\u7840\u7EC4\u5408"
    title: "\u5148\u8BA4\u4E09\u4E2A\u7EC4\u5408\uFF1A\u5BF9\u5B50\u3001\u523B\u5B50\u3001\u987A\u5B50"
    summary: "\u4E24\u5F20\u76F8\u540C\u662F\u5BF9\u5B50\uFF1B\u4E09\u5F20\u76F8\u540C\u662F\u523B\u5B50\u3002\n\u540C\u4E00\u82B1\u8272\u7684\u4E09\u5F20\u8FDE\u7EED\u6570\u724C\uFF0C\u624D\u662F\u987A\u5B50\u3002"
    narration: "\u4E24\u5F20\u4E8C\u4E07\u662F\u4E00\u5BF9\uFF0C\u4E09\u5F20\u4E03\u7B52\u662F\u4E00\u523B\uFF0C\u56DB\u4E94\u516D\u6761\u662F\u4E00\u987A\u3002\u987A\u5B50\u5FC5\u987B\u540C\u82B1\u8272\uFF0C\u800C\u4E14\u4E0D\u80FD\u628A\u4E5D\u3001\u4E00\u3001\u4E8C\u63A5\u8D77\u6765\uFF01\u8FD9\u4E9B\u662F\u4E4B\u540E\u5B66\u4E60\u548C\u724C\u7684\u57FA\u7840\u3002"
    takeaway: "\u8BA4\u8BC6\u7EC4\u5408\u53EA\u662F\u7B2C\u4E00\u6B65\uFF1B\u662F\u5426\u80FD\u548C\u724C\uFF0C\u8FD8\u8981\u6EE1\u8DB3\u56FD\u6807\u548C\u724C\u6761\u4EF6\u3002"
    groups:
    - heading: "\u5BF9\u5B50 / \u4E24\u5F20\u76F8\u540C"
      tileIds: 0c0000000c000000
    - heading: "\u523B\u5B50 / \u4E09\u5F20\u76F8\u540C"
