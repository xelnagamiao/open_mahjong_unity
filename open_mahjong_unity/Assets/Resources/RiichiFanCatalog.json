  "entries": [
    {
      "number": 1,
      "name": "立直",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "门清限定。\n整理阶段，当任何一家同时符合以下条件，可宣布立直并横置舍牌：\n- 门清听牌\n- 牌墙不计王牌还有剩余张数\n立直后和了可得一番。",
      "note": "",
      "context": "门前清；已宣告立直",
      "example": "123m 456m 234p 678s 5p 5p",
      "sourcePage": 16,
      "sourcePages": [
        16,
        17,
        23
      ]
    },
    {
      "number": 2,
      "name": "一发",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "门清限定。立直后第一巡内和牌，若中途有人鸣牌或暗杠，便不成立。",
      "note": "",
      "context": "门前清；已宣告立直",
      "example": "123m 456m 234p 678s 5p 5p",
      "sourcePage": 24
    },
    {
      "number": 3,
      "name": "门前清自摸和",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "门清限定。门前清的自摸和牌。",
      "note": "",
      "context": "门前清；自摸",
      "example": "123m 456m 234p 678s 5p 5p",
      "sourcePage": 24
    },
    {
      "number": 4,
      "name": "平和",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "门清限定。和牌时，和牌没有任何额外的「符」，自摸/门前荣和符例外。即：四面子全为顺子。必须为两面听牌。雀头不能是役牌，但可为客风字牌。",
      "note": "",
      "context": "门前清；两面听牌",
      "example": "123m 456m 234p 67s 55p 8s",
      "sourcePage": 24
    },
    {
      "number": 5,
      "name": "断幺九",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "和牌时，和牌没有任何么九牌，么九牌包括一、九的数牌及所有字牌。",
      "note": "",
      "context": "",
      "example": "234m 456m 234p 678s 5p 5p",
      "sourcePage": 24
    },
    {
      "number": 6,
      "name": "一杯口",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "门清限定。和牌时，手牌有两个相同的顺子。",
      "note": "",
      "context": "门前清",
      "example": "123m 123m 456p 789s 55p",
      "sourcePage": 24
    },
    {
      "number": 7,
      "name": "役牌",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "有一个场风、自风或三元牌（役牌）的刻子。场风和自风可以叠加计算。",
      "note": "",
      "context": "",
      "example": "555z 123m 456p 789s 22p",
      "sourcePage": 24
    },
    {
      "number": 8,
      "name": "岭上开花",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "杠后补牌马上自摸。",
      "note": "",
      "context": "第一组为杠；末张为杠后补牌",
      "example": "1111m 234m 456p 678s 5p 5p",
      "sourcePage": 24
    },
    {
      "number": 9,
      "name": "抢杠和",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "他家加杠的牌正好是自己和了的牌。十三么九无特权，不可抢暗杠。",
      "note": "",
      "context": "末张为他家加杠的牌",
      "example": "123m 456m 234p 678s 5p 5p",
      "sourcePage": 24
    },
    {
      "number": 10,
      "name": "海底摸月",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
      "description": "自摸王牌前的最后一张牌和了。杠尾的牌不算在内。",
      "note": "",
      "context": "末张为最后一张摸牌",
      "example": "123m 456m 234p 678s 5p 5p",
      "sourcePage": 24
    },
    {
      "number": 11,
      "name": "河底捞鱼",
      "fan": 1,
      "category": "1",
      "valueText": "1 番",
