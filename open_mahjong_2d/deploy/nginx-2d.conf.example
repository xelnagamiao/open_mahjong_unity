# Add the two proxy locations before the static /2d/ location.
# Replace upstream host names and ports with the existing Salasasa services.

location /2d/api/ {
    proxy_pass http://open_mahjong_web:3000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /2d/ws/ {
    proxy_pass http://open_mahjong_server:8081/game/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location /2d/ {
    # Copy dist/ to /srv/www/salasasa/2d/.
    root /srv/www/salasasa;
    try_files $uri $uri/ /2d/index.html;
}
