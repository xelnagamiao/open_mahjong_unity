#!/bin/sh
# Remove a stale .git/index.lock left behind by an interrupted git command.
# A lock younger than 10 minutes may belong to an active git process, so it is
# left untouched to avoid corrupting the index.
git_dir=$(git rev-parse --git-dir)
lock="$git_dir/index.lock"
if [ -f "$lock" ]; then
  python - "$lock" <<'PY'
import os, sys, time
path = sys.argv[1]
age = time.time() - os.path.getmtime(path)
if age >= 600:
    os.remove(path)
    print("[hook] removed stale index.lock (%.0f s old)" % age)
else:
    print("[hook] index.lock is only %.0f s old; another git process may be running, leaving it" % age)
PY
fi
exit 0
